    "privacy-policy.html": {
      "settings": {
        "title": "Privacy Policy",
        "order": "3",
        "meta_descr": "Privacy Policy For Glucotru"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-section-title": {
